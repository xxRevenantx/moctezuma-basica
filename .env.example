# Disco privado para expedientes de alumnos y personal
FILESYSTEM_DISK=public
EXPEDIENTES_DISK=local
FOTOS_DISK=public

# Centro de control y tareas programadas
SYSTEM_BACKUP_DISK=local
SYSTEM_BACKUP_RETENTION_DAYS=30
SYSTEM_BACKUP_SCHEDULE=02:00
SYSTEM_INTEGRITY_SCHEDULE=06:00


# Optimizador inteligente de horarios (Python + Google OR-Tools)
# Windows/Laragon: usa la ruta absoluta del Python del entorno virtual.
# Ejemplo: C:\laragon\www\moctezuma-basica\.venv-horarios\Scripts\python.exe
HORARIOS_PYTHON_BIN=C:/laragon/www/moctezuma-basica/.venv-horarios/Scripts/python.exe
HORARIOS_SCRIPT_PATH=C:/laragon/www/moctezuma-basica/scripts/horarios/optimize.py

HORARIOS_SOLVER_TIMEOUT=90
HORARIOS_SOLVER_SECONDS_PER_OBJECTIVE=12
HORARIOS_MIN_SLOT_MINUTES=40
HORARIOS_MAX_PROPUESTAS=4

# Analítica institucional avanzada
ANALITICA_SNAPSHOT_SCHEDULE=07:00
ANALITICA_TREND_CYCLES=5
ANALITICA_PASSING_GRADE=6
ANALITICA_ALERTA_MATRICULA_CAIDA=5
ANALITICA_ALERTA_RIESGO_ALTO=10
ANALITICA_ALERTA_DOCUMENTACION_MINIMA=85
ANALITICA_ALERTA_PERMANENCIA_MINIMA=90

# Consulta externa de CURP (la validación local funciona sin estas variables)
CURP_API_URL=https://api.valida-curp.com.mx/curp/obtener_datos/
CURP_API_TOKEN=""
CURP_API_TIMEOUT=15
CURP_API_CONNECT_TIMEOUT=5

# OCR local para tutores (INE y constancia de CURP)
# No utiliza tokens ni APIs externas. Los ejecutables también se detectan desde PATH.
TUTOR_OCR_ENABLED=true
TESSERACT_BINARY=""
TESSERACT_LANGUAGE="spa+eng"
PDFTOPPM_BINARY=""
IMAGEMAGICK_BINARY=""
TUTOR_OCR_TIMEOUT=90
TUTOR_OCR_MAX_PAGES=2
TUTOR_OCR_MAX_FILE_KB=12288
TUTOR_OCR_MIN_TEXT_LENGTH=35
TUTOR_OCR_SHOW_RAW_TEXT=false

TEACHER_INTERNAL_DOMAIN=profesor.moctezuma.local
