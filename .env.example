APP_NAME=Moctezuma-Básica
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://moctezuma-basica.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moctezuma_basica
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
TINYMCE_API_KEY="s"

# GroqCloud
GROQ_ENABLED=true
GROQ_API_KEY=gsk_REEMPLAZA_AQUI_TU_CLAVE
GROQ_BASE_URL=https://api.groq.com/openai/v1

GROQ_MODEL=openai/gpt-oss-20b

GROQ_CONNECT_TIMEOUT=8
GROQ_STATUS_TIMEOUT=15
GROQ_REQUEST_TIMEOUT=60

GROQ_TEMPERATURE=0.35
GROQ_MAX_TOKENS=450

GROQ_INCLUDE_CONTEXT=false

